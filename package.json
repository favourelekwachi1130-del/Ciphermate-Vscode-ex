    "configuration": {
      "title": "CipherMate",
      "properties": {
        "ciphermate.scanners.enableDependency": {
          "type": "boolean",
          "default": true,
          "description": "Enable dependency vulnerability scanner",
          "markdownDescription": "Scans `package.json`, `requirements.txt`, `Cargo.toml`, and other dependency files for known CVEs."
        },
        "ciphermate.scanners.enableRetire": {
          "type": "boolean",
          "default": true,
          "description": "Use retire.js for npm CVE scanning (enables one-click SCA AutoFix)",
          "markdownDescription": "Scans package.json for vulnerable npm packages. Required for one-click dependency fixes."
        },
        "ciphermate.scanners.enableSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Enable hardcoded secrets detection",
          "markdownDescription": "Detects AWS keys, API tokens, passwords, and other secrets in code."
        },
        "ciphermate.scanners.enableSmartContract": {
          "type": "boolean",
          "default": true,
          "description": "Enable smart contract security scanner",
          "markdownDescription": "Scans Solidity files for reentrancy, access control, and other blockchain vulnerabilities."
        },
        "ciphermate.scanners.enableCodePattern": {
          "type": "boolean",
          "default": true,
          "description": "Enable code pattern scanner (OWASP Top 10)",
          "markdownDescription": "Detects SQL injection, XSS, command injection, and other OWASP Top 10 vulnerabilities."
        },
        "ciphermate.scanners.enableSemgrep": {
          "type": "boolean",
          "default": true,
          "description": "Enable Semgrep static analysis",
          "markdownDescription": "Uses Semgrep for advanced pattern matching and security rule detection."
        },
        "ciphermate.scanners.enableBandit": {
          "type": "boolean",
          "default": true,
          "description": "Enable Bandit Python security scanning",
          "markdownDescription": "Python-specific security scanner for common vulnerabilities."
        },
        "ciphermate.scanners.enableSnyk": {
          "type": "boolean",
          "default": false,
          "description": "Enable Snyk dependency scanning",
          "markdownDescription": "Uses Snyk CLI for dependency/CVE scanning. Requires: npm install -g snyk, then snyk auth."
        },
        "ciphermate.scanners.enableCodeQL": {
          "type": "boolean",
          "default": false,
          "description": "Enable GitHub CodeQL static analysis",
          "markdownDescription": "Uses CodeQL CLI (GitHub Advanced Security). Download from https://github.com/github/codeql-action/releases"
        },
        "ciphermate.scanners.enableCipherMateSAST": {
          "type": "boolean",
          "default": true,
          "description": "Enable CipherMate AI SAST",
          "markdownDescription": "Our own AI-powered static analysis (no paid tools). Uses pattern matching + AI validation."
        },
        "ciphermate.scanners.cipherMateSASTMinConfidence": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "maximum": 100,
          "description": "Min confidence % to show findings",
          "markdownDescription": "Findings below this confidence are hidden. Pattern-only: ~50%. AI-validated: ~88%."
        },
        "ciphermate.eagleEye.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Eagle Eye: AI-powered silent scans on save",
          "markdownDescription": "Runs AI + pattern analysis on saved files. Findings appear in the dashboard with 'Eagle Eye' badge."
        },
        "ciphermate.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files when saved",
          "markdownDescription": "Triggers a security scan automatically when you save a file."
        },
        "ciphermate.scanInterval": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of saves before triggering a full scan",
          "markdownDescription": "Controls how frequently scans run. Higher values = less frequent scans."
        },
        "ciphermate.scanBehavior.scanOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Run scan automatically when workspace opens",
          "markdownDescription": "Performs an initial scan when you open a workspace."
        },
        "ciphermate.scanBehavior.scanMode": {
          "type": "string",
          "enum": [
            "full",
            "incremental",
            "changed-only"
          ],
          "enumDescriptions": [
            "Scan entire repository every time",
            "Scan only changed files since last scan",
            "Scan only currently modified files"
          ],
          "default": "incremental",
          "description": "Scan mode",
          "markdownDescription": "**Full**: Always scan everything. **Incremental**: Only scan changed files. **Changed-only**: Only scan currently open/modified files."
        },
        "ciphermate.scanBehavior.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "minimum": 1024,
          "maximum": 10485760,
          "description": "Maximum file size to scan (bytes)",
          "markdownDescription": "Files larger than this will be skipped. Default: 1MB. Max: 10MB."
        },
        "ciphermate.scanBehavior.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/target/**",
            "**/vendor/**",
            "**/.venv/**",
            "**/venv/**"
          ],
          "description": "File patterns to exclude from scanning",
          "markdownDescription": "Glob patterns for files/directories to skip. Uses VS Code's glob syntax."
        },
        "ciphermate.scanBehavior.severityFilter": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "default": [],
          "description": "Only show vulnerabilities of these severities (empty = show all)",
          "markdownDescription": "Filter results by severity level. Leave empty to show all vulnerabilities."
        },
        "ciphermate.useCloudAI": {
          "type": "boolean",
          "default": true,
          "description": "Use cloud-based AI service (your trained model). Set to false to use local AI (LM Studio/Ollama)."
        },
        "ciphermate.ai.useMultiProvider": {
          "type": "boolean",
          "default": true,
          "description": "Use multi-provider AI system (supports 450+ models via OpenRouter, Claude, Gemini, GPT-5, etc.)"
        },
        "ciphermate.ai.provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai",
            "anthropic",
            "gemini",
            "ollama",
            "custom"
          ],
          "default": "openrouter",
          "description": "Primary AI provider. OpenRouter supports 450+ models. Ollama for local/self-hosted models (DeepSeek Coder, etc.)"
        },
        "ciphermate.ai.openrouter": {
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "default": "",
              "description": "OpenRouter API key (get from https://openrouter.ai)"
            },
            "model": {
              "type": "string",
              "default": "openrouter/free",
              "description": "Default model. openrouter/free = free tier (auto-selects). Or use anthropic/claude-sonnet-4, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-exp, etc. See https://openrouter.ai/models"
            },
            "timeout": {
              "type": "number",
              "default": 30000,
              "description": "Request timeout in milliseconds"
            }
          }
        },
        "ciphermate.ai.openai": {
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "default": "",
              "description": "OpenAI API key"
            },
            "model": {
              "type": "string",
              "default": "gpt-4",
              "description": "OpenAI model (gpt-5, gpt-4, gpt-3.5-turbo, etc.)"
            },
            "timeout": {
              "type": "number",
              "default": 30000,
              "description": "Request timeout in milliseconds"
            }
          }
        },
        "ciphermate.ai.anthropic": {
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "default": "",
              "description": "Anthropic API key (for Claude models)"
            },
            "model": {
              "type": "string",
              "default": "claude-3-5-sonnet-20241022",
              "description": "Claude model (claude-sonnet-4-20250514, claude-3-5-sonnet, etc.)"
            },
            "timeout": {
              "type": "number",
              "default": 30000,
              "description": "Request timeout in milliseconds"
            }
          }
        },
        "ciphermate.ai.ollama": {
          "type": "object",
          "properties": {
            "apiUrl": {
              "type": "string",
              "default": "http://localhost:11434",
              "description": "Ollama server URL (e.g., http://localhost:11434 or http://your-server:11434)"
            },
            "model": {
              "type": "string",
              "default": "deepseek-coder:6.7b",
              "description": "Ollama model name (e.g., 'deepseek-coder:6.7b', 'deepseek-coder:1.3b', 'deepseek-coder:33b', 'codellama:7b')"
            },
            "timeout": {
              "type": "number",
              "default": 120000,
              "description": "Request timeout in milliseconds (local models may need longer)"
            }
          }
        },
        "ciphermate.ai.gemini": {
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "default": "",
              "description": "Google AI API key (for Gemini models)"
            },
            "model": {
              "type": "string",
              "default": "gemini-1.5-pro",
              "description": "Gemini model (gemini-2.0-flash-exp, gemini-1.5-pro, etc.)"
            },
            "timeout": {
              "type": "number",
              "default": 30000,
              "description": "Request timeout in milliseconds"
            }
          }
        },
        "ciphermate.ai.custom": {
          "type": "object",
          "properties": {
            "apiUrl": {
              "type": "string",
              "default": "",
              "description": "Custom API endpoint (must be OpenAI-compatible)"
            },
            "apiKey": {
              "type": "string",
              "default": "",
              "description": "API key for custom provider"
            },
            "model": {
              "type": "string",
              "default": "",
              "description": "Model name"
            },
            "timeout": {
              "type": "number",
              "default": 30000,
              "description": "Request timeout in milliseconds"
            }
          }
        },
        "ciphermate.ai.conversationModel": {
          "type": "string",
          "default": "openrouter/free",
          "description": "Model for conversational chat. Use openrouter/free for free tier. Leave empty to use ai.openrouter.model."
        },
        "ciphermate.ai.conversationProvider": {
          "type": "string",
          "enum": [
            "",
            "openrouter",
            "openai",
            "anthropic",
            "gemini",
            "ollama"
          ],
          "default": "",
          "description": "Optional: Use a different provider for conversational chat. Leave empty to use primary provider."
        },
        "ciphermate.ai.codingModel": {
          "type": "string",
          "default": "anthropic/claude-sonnet-4",
          "description": "Model for coding tasks: security scans, fixes, code explanation. User-selectable in chat. Options: anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-exp (faster/cheaper), deepseek/deepseek-chat-v3 (budget). See https://openrouter.ai/models"
        },
        "ciphermate.ai.fallbackProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic",
              "gemini",
              "openrouter"
            ]
          },
          "default": [],
          "description": "Fallback providers to use if primary provider fails (in order)"
        },
        "ciphermate.cloudAI": {
          "type": "object",
          "properties": {
            "apiUrl": {
              "type": "string",
              "default": "https://api.ciphermate.ai/v1/chat/completions",
              "description": "Your custom AI service API endpoint (legacy, use ai.provider instead)"
            },
            "apiKey": {
              "type": "string",
              "default": "",
              "description": "API key for authentication (stored securely)"
            },
            "modelName": {
              "type": "string",
              "default": "ciphermate-security-agent",
              "description": "Model name/version identifier"
            },
            "timeout": {
              "type": "number",
              "default": 30000,
              "description": "Request timeout in milliseconds"
            }
          }
        },
        "ciphermate.lmStudioUrl": {
          "type": "string",
          "default": "http://localhost:1234/v1/chat/completions",
          "description": "LM Studio API endpoint URL (only used if useCloudAI is false)"
        },
        "ciphermate.enableLiveReview": {
          "type": "boolean",
          "default": true,
          "description": "Always watch code and show security issues as you edit (static analysis, no AI required)"
