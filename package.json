    "ollama-ai-provider-v2": "^3.3.0",
    "openai": "^6.10.0",
    "zod": "^3.22.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode production",
    "compile:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "pretest": "npm run compile-tests && npm run compile:dev && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "vscode-test",
    "test:unit": "vscode-test --label 'Unit Tests - Fix System'",
    "test:scanners": "vscode-test --label 'Unit Tests - Scanners'",
    "test:integration": "vscode-test --label 'Integration Tests'",
    "test:e2e": "vscode-test --label 'E2E Tests'",
    "test:existing": "vscode-test --label 'Existing Tests'",
    "test:all": "vscode-test --label 'All Tests'",
    "test:standalone": "mocha out/test/standalone/**/*.test.js --timeout 30000",
    "test:enterprise": "node ./out/test/enterprise.test.js",
    "test:coverage": "nyc npm test",
    "build": "npm run compile && npm run test",
    "dev": "npm run compile:dev && code --extensionDevelopmentPath=. --disable-extensions",
    "clean": "rimraf out dist *.vsix",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "nyc": "^15.1.0",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vsce": "^2.15.0",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  }
