{
  "name": "ciphermate",
  "displayName": "CipherMate",
  "description": "AI-powered security assistant with intelligent vulnerability detection, team collaboration, and encrypted memory",
  "version": "1.1.0",
  "publisher": "ciphermate",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Linters",
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "security",
    "vulnerability",
    "ai",
    "semgrep",
    "bandit",
    "static-analysis",
    "code-quality",
    "team-collaboration"
  ],
  "activationEvents": [
    "onView:ciphermateWelcome",
    "onView:ciphermateFindings",
    "onCommand:ciphermate",
    "onCommand:ciphermate.chat",
    "onCommand:ciphermate.scan",
    "onCommand:ciphermate.intelligentScan",
    "onCommand:ciphermate.showResults",
    "onCommand:ciphermate.settings",
    "onCommand:ciphermate.advancedSettings",
    "onCommand:ciphermate.home",
    "onCommand:ciphermate.login",
    "onCommand:ciphermate.loginGoogle",
    "onCommand:ciphermate.loginMicrosoft",
    "onCommand:ciphermate.logout",
    "onCommand:ciphermate.userProfile",
    "onCommand:ciphermate.cancelScan",
    "onCommand:ciphermate.showCommands",
    "onCommand:ciphermate.redTeamOps"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#4FC3F7",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ciphermate.git"
  },
  "homepage": "https://github.com/your-username/ciphermate#readme",
  "bugs": {
    "url": "https://github.com/your-username/ciphermate/issues"
  },
  "license": "MIT",
  "optionalDependencies": {
    "bandit": "*",
    "semgrep": "*"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ciphermate",
          "title": "CipherMate",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "ciphermate": [
        {
          "id": "ciphermateWelcome",
          "name": "Welcome",
          "when": "true"
        },
        {
          "id": "ciphermateFindings",
          "name": "Findings"
        }
      ]
    },
    "viewsWelcome": {
      "ciphermate": [
        {
          "contents": "**Welcome to CipherMate!**\n\nAI-powered security assistant for VS Code.\n\n**Quick Start:**\n1. [Configure API Key](command:ciphermate.advancedSettings) - Set up your AI provider\n2. [Start Chatting](command:ciphermate) - Begin using CipherMate\n3. [View Results](command:ciphermate.showResults) - See security findings\n\n**Need Help?** Click any command above to get started.",
          "when": "true"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "ciphermate.scan",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.intelligentScan",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.showResults",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.incrementalScan",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.runBenchmark",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.generateFix",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.redTeamAttack",
          "when": "workspaceFolderCount > 0"
        },  
        {
          "command": "ciphermate.orgLearningInsights",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.personalizedRecommendations",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.createCustomRule",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.vulnerabilityForecast",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.attackTrends",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.complianceCheck",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.complianceReport",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "ciphermate.advancedSettings"
        },
        {
          "command": "ciphermate.home"
        },
        {
          "command": "ciphermate.login"
        },
        {
          "command": "ciphermate.loginGoogle"
        },
        {
          "command": "ciphermate.loginMicrosoft"
        },
        {
          "command": "ciphermate.logout"
        },
        {
          "command": "ciphermate.userProfile"
        },
        {
          "command": "ciphermate.cancelScan"
        },
        {
          "command": "ciphermate.showCommands"
        },
        {
          "command": "ciphermate.redTeamOps"
        }
      ],
      "editor/context": [
        {
          "command": "ciphermate.scan",
          "group": "ciphermate",
          "when": "resourceExtname =~ /\\.(js|ts|py|php|java|c|cpp|cs|go|rs|rb|sh)$/"
        }
      ]
    },
